# ─── LLM (Google Gemini) ───────────────────────────────────────────────
# Clé API gratuite : https://aistudio.google.com/app/apikey
# Sans clé, l'app tourne en MODE DÉMO (jeu d'exemple, pas d'appel LLM).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ─── Redis (source de vérité intermédiaire des agents) ─────────────────
# Optionnel : si absent ou injoignable, fallback automatique en mémoire + disque.
REDIS_URL=redis://localhost:6379

# ─── Serveur ───────────────────────────────────────────────────────────
PORT=3001
# URL publique utilisée pour construire les liens de partage du jeu.
PUBLIC_URL=http://localhost:5173
